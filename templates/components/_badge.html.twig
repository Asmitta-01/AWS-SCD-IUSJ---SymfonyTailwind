{% set tone = tone|default('muted') %}<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium {{ tone == 'success' ? 'bg-emerald-50 text-emerald-700' : tone == 'warning' ? 'bg-warning-soft text-warning-foreground' : tone == 'danger' ? 'bg-red-50 text-red-700' : 'bg-muted text-muted-foreground' }}">{{ label }}</span>
