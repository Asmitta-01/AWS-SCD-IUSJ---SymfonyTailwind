{% set navigation = [
    { route: 'dashboard', label: 'Dashboard', icon: 'dashboard' },
    { route: 'sales', label: 'Sales', icon: 'sales' },
    { route: 'customers', label: 'Customers', icon: 'customers' },
    { route: 'products', label: 'Products', icon: 'products' },
    { route: 'transactions', label: 'Transactions', icon: 'transactions' },
    { route: 'reports', label: 'Reports', icon: 'reports' },
    { route: 'settings', label: 'Settings', icon: 'settings' }
] %}
<header class="sticky top-0 z-20 border-b border-border bg-card/95 backdrop-blur">
    <div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <div class="flex min-w-0 items-center gap-3">
            <details class="relative lg:hidden">
                <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-md border border-border text-muted-foreground hover:bg-muted">
                    {% include 'components/_icon.html.twig' with {name: 'menu'} %}<span class="sr-only">Open navigation</span>
                </summary>
                <div class="absolute left-0 top-11 z-30 w-64 rounded-lg border border-border bg-card p-3 shadow-lg">
                    <div class="mb-4 flex items-center gap-3 border-b border-border px-2 pb-4"><span class="grid size-8 place-items-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground">S</span><div><p class="text-sm font-semibold">SalesBoard</p><p class="text-[11px] text-muted-foreground">Operations console</p></div></div>
                    <nav aria-label="Mobile navigation" class="space-y-1">
                        {% for item in navigation %}
                            <a href="{{ path(item.route) }}" class="flex items-center gap-3 rounded-md px-3 py-2 text-sm {{ app.request.attributes.get('_route') == item.route ? 'bg-accent font-medium text-accent-foreground' : 'text-muted-foreground hover:bg-muted hover:text-foreground' }}">{% include 'components/_icon.html.twig' with {name: item.icon} %}{{ item.label }}</a>
                        {% endfor %}
                    </nav>
                </div>
            </details>
            <div class="min-w-0"><h1 class="truncate text-base font-semibold tracking-tight sm:text-lg">{{ title }}</h1><p class="truncate text-[13px] text-muted-foreground">{{ subtitle }}</p></div>
        </div>
        <div class="flex items-center gap-2">
            <div class="hidden items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-xs text-muted-foreground sm:flex">{% include 'components/_icon.html.twig' with {name: 'calendar', class: 'size-3.5'} %}Last 30 days</div>
            <button type="button" aria-label="Notifications" class="relative grid size-9 place-items-center rounded-md border border-border text-muted-foreground hover:bg-muted hover:text-foreground">{% include 'components/_icon.html.twig' with {name: 'bell'} %}<span class="absolute right-1.5 top-1.5 size-1.5 rounded-full bg-primary"></span></button>
            <div class="hidden items-center gap-2 rounded-md border border-border px-2 py-1.5 sm:flex"><span class="grid size-7 place-items-center rounded-full bg-primary text-[11px] font-medium text-primary-foreground">AU</span><span class="text-sm font-medium">Admin</span></div>
        </div>
    </div>
</header>
