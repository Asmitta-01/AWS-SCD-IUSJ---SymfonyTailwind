<article class="rounded-lg border border-border bg-card p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div><p class="text-xs font-medium text-muted-foreground">{{ label }}</p><p class="mt-2 font-mono text-2xl font-semibold tracking-tight tabular-nums">{{ value }}</p></div>
        <span class="grid size-9 place-items-center rounded-md bg-accent text-accent-foreground">{% include 'components/_icon.html.twig' with {name: icon} %}</span>
    </div>
    {% if change is defined %}<p class="mt-3 text-xs"><span class="font-medium text-primary">{{ change }}</span> <span class="text-muted-foreground">{{ comparison|default('vs. previous month') }}</span></p>{% endif %}
</article>
