{% extends 'base.html.twig' %}

{% block title %}Customers - SalesBoard{% endblock %}
{% block page_heading %}Customers{% endblock %}
{% block page_subtitle %}Manage your customer relationships{% endblock %}

{% block body %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-xl font-semibold tracking-tight">All customers</h2><p class="mt-1 text-sm text-muted-foreground">{{ customers|length }} contacts in your workspace</p></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90"><span class="text-lg leading-none">+</span> Add customer</button></div>
    <form method="get" class="overflow-hidden rounded-lg border border-border bg-card shadow-sm"><div class="flex items-center gap-3 border-b border-border p-4"><label class="relative flex-1"><span class="sr-only">Search customers</span>{% include 'components/_icon.html.twig' with {name: 'search', class: 'absolute left-3 top-2.5 size-4 text-muted-foreground'} %}<input type="search" name="q" value="{{ search }}" placeholder="Search customers..." class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm outline-none placeholder:text-muted-foreground focus:ring-2 focus:ring-ring"></label><button type="submit" class="rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-muted">Search</button></div><div class="overflow-x-auto"><table class="w-full min-w-[680px] text-sm"><thead><tr class="border-b border-border bg-muted/40 text-left text-[10px] uppercase tracking-wider text-muted-foreground"><th class="px-5 py-3 font-medium">Name</th><th class="px-3 py-3 font-medium">Email</th><th class="px-3 py-3 font-medium">Company</th><th class="px-5 py-3 text-right font-medium">Status</th></tr></thead><tbody class="divide-y divide-border">{% for customer in customers %}<tr class="transition-colors hover:bg-muted/60"><td class="px-5 py-3 font-medium">{{ customer.fullName }}</td><td class="px-3 py-3 text-muted-foreground">{{ customer.email }}</td><td class="px-3 py-3">{{ customer.companyName ?: '-' }}</td><td class="px-5 py-3 text-right">{% include 'components/_badge.html.twig' with {label : customer.status.value|capitalize, tone : customer.status.value == 'active' ? 'success' : 'muted'} %}</td></tr>{% else %}<tr><td colspan="4" class="px-5 py-8 text-center text-sm text-muted-foreground">No customers found.</td></tr>{% endfor %}</tbody></table></div></form>
{% endblock %}
