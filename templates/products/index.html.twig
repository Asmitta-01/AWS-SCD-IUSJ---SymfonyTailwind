{% extends 'base.html.twig' %}

{% block title %}Products - SalesBoard{% endblock %}
{% block page_heading %}Products{% endblock %}
{% block page_subtitle %}Manage inventory and stock levels{% endblock %}

{% block body %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-xl font-semibold tracking-tight">Product catalog</h2><p class="mt-1 text-sm text-muted-foreground">{{ products|length }} products across all categories</p></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90"><span class="text-lg leading-none">+</span> Add product</button></div>
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm"><div class="flex items-center gap-3 border-b border-border p-4"><label class="relative flex-1"><span class="sr-only">Search products</span>{% include 'components/_icon.html.twig' with {name: 'search', class: 'absolute left-3 top-2.5 size-4 text-muted-foreground'} %}<input type="search" placeholder="Search products..." class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm outline-none placeholder:text-muted-foreground focus:ring-2 focus:ring-ring"></label></div><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-sm"><thead><tr class="border-b border-border bg-muted/40 text-left text-[10px] uppercase tracking-wider text-muted-foreground"><th class="px-5 py-3 font-medium">Product</th><th class="px-3 py-3 font-medium">SKU</th><th class="px-3 py-3 font-medium">Category</th><th class="px-3 py-3 text-right font-medium">Price</th><th class="px-5 py-3 text-right font-medium">Stock</th></tr></thead><tbody class="divide-y divide-border">{% for product in products %}<tr class="transition-colors hover:bg-muted/60"><td class="px-5 py-3 font-medium">{{ product.name }}</td><td class="px-3 py-3 font-mono text-xs text-muted-foreground">{{ product.sku }}</td><td class="px-3 py-3 text-muted-foreground">{{ product.category.name }}</td><td class="px-3 py-3 text-right font-mono tabular-nums">{{ product.price|number_format(2) }}</td><td class="px-5 py-3 text-right">{% include 'components/_badge.html.twig' with {label : product.stockQuantity ~ ' units', tone : product.isOutOfStock ? 'danger' : product.isLowStock ? 'warning' : 'success'} %}</td></tr>{% else %}<tr><td colspan="5" class="px-5 py-8 text-center text-sm text-muted-foreground">No products found.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
