{% extends 'base.html.twig' %}

{% block title %}Products - SalesBoard{% endblock %}

{% block body %}
    <h1>Products</h1><table><tr><th>Name</th><th>SKU</th><th>Category</th><th>Price</th><th>Stock</th></tr>{% for product in products %}<tr><td>{{ product.name }}</td><td>{{ product.sku }}</td><td>{{ product.category.name }}</td><td>{{ product.price|number_format(2) }}</td><td>{{ product.stockQuantity }}</td></tr>{% endfor %}</table>
{% endblock %}
