{% extends 'base.html.twig' %}

{% block title %}Reports - SalesBoard{% endblock %}
{% block page_heading %}Reports{% endblock %}
{% block page_subtitle %}Understand trends across your business{% endblock %}

{% block body %}
    <div><h2 class="text-xl font-semibold tracking-tight">Business reports</h2><p class="mt-1 text-sm text-muted-foreground">Completed sales revenue: <span class="font-mono font-medium text-foreground">{{ stats.totalRevenue|number_format(2) }}</span></p></div>
    <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="rounded-lg border border-border bg-card p-5 shadow-sm"><h2 class="text-sm font-semibold">Revenue by month</h2><div class="mt-6 space-y-4">{% for month, amount in stats.salesOverTime %}<div><div class="mb-1 flex justify-between text-xs"><span class="text-muted-foreground">{{ month }}</span><span class="font-mono tabular-nums">{{ amount|number_format(2) }}</span></div><div class="h-2 overflow-hidden rounded-full bg-muted"><div class="h-full rounded-full bg-primary" style="width: {{ ((amount / stats.totalRevenue) * 100)|round }}%"></div></div></div>{% else %}<p class="text-sm text-muted-foreground">No monthly data available.</p>{% endfor %}</div></div>
        <div class="rounded-lg border border-border bg-card p-5 shadow-sm"><h2 class="text-sm font-semibold">Top products</h2><ol class="mt-4 divide-y divide-border">{% for name, quantity in stats.topProducts %}<li class="flex items-center justify-between gap-3 py-3"><span class="truncate text-sm font-medium">{{ loop.index }}. {{ name }}</span><span class="font-mono text-xs text-muted-foreground">{{ quantity }} sold</span></li>{% else %}<li class="py-3 text-sm text-muted-foreground">No product data available.</li>{% endfor %}</ol></div>
    </section>
{% endblock %}
