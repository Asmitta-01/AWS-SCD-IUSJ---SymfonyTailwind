{% extends 'base.html.twig' %}{% block title %}Reports - SalesBoard{% endblock %}{% block body %}<h1>Reports</h1><p>Completed sales revenue: {{ stats.totalRevenue|number_format(2) }}</p><h2>Sales by month</h2><ul>{% for month, amount in stats.salesOverTime %}<li>{{ month }}: {{ amount|number_format(2) }}</li>{% endfor %}</ul><h2>Top products</h2><ul>{% for name, quantity in stats.topProducts %}<li>{{ name }}: {{ quantity }} sold</li>{% endfor %}</ul>{% endblock %}
