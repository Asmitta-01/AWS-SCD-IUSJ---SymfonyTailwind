{% extends 'base.html.twig' %}

{% block title %}Sales - SalesBoard{% endblock %}
{% block page_heading %}Sales{% endblock %}
{% block page_subtitle %}Track and manage customer orders{% endblock %}

{% block body %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="text-xl font-semibold tracking-tight">All sales</h2><p class="mt-1 text-sm text-muted-foreground">{{ sales|length }} records in your workspace</p></div><button type="button" class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90"><span class="text-lg leading-none">+</span> New sale</button></div>
    <div class="flex flex-col gap-3 rounded-lg border border-border bg-card p-4 shadow-sm sm:flex-row"><label class="relative flex-1"><span class="sr-only">Search sales</span>{% include 'components/_icon.html.twig' with {name: 'search', class: 'absolute left-3 top-2.5 size-4 text-muted-foreground'} %}<input type="search" placeholder="Search sales..." class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm outline-none ring-primary placeholder:text-muted-foreground focus:ring-2"></label><select class="h-9 rounded-md border border-input bg-background px-3 text-sm text-muted-foreground"><option>All statuses</option><option>Completed</option><option>Pending</option><option>Cancelled</option></select></div>
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm"><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-sm"><thead><tr class="border-b border-border bg-muted/40 text-left text-[10px] uppercase tracking-wider text-muted-foreground"><th class="px-5 py-3 font-medium">Reference</th><th class="px-3 py-3 font-medium">Customer</th><th class="px-3 py-3 font-medium">Date</th><th class="px-3 py-3 text-right font-medium">Total</th><th class="px-5 py-3 text-right font-medium">Status</th></tr></thead><tbody class="divide-y divide-border">{% for sale in sales %}<tr class="transition-colors hover:bg-muted/60"><td class="px-5 py-3 font-mono text-xs font-medium">{{ sale.reference }}</td><td class="px-3 py-3 font-medium">{{ sale.customer.fullName }}</td><td class="px-3 py-3 font-mono text-xs text-muted-foreground">{{ sale.saleDate|date('Y-m-d') }}</td><td class="px-3 py-3 text-right font-mono tabular-nums">{{ sale.total|number_format(2) }}</td><td class="px-5 py-3 text-right">{% include 'components/_badge.html.twig' with {label : sale.status.value|capitalize, tone : sale.status.value == 'completed' ? 'success' : sale.status.value == 'pending' ? 'warning' : 'muted'} %}</td></tr>{% else %}<tr><td colspan="5" class="px-5 py-8 text-center text-sm text-muted-foreground">No sales found.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
