{% extends 'base.html.twig' %}{% block title %}Sales - SalesBoard{% endblock %}{% block body %}<h1>Sales</h1><table><tr><th>Reference</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th></tr>{% for sale in sales %}<tr><td>{{ sale.reference }}</td><td>{{ sale.customer.fullName }}</td><td>{{ sale.saleDate|date('Y-m-d') }}</td><td>{{ sale.total|number_format(2) }}</td><td>{{ sale.status.value }}</td></tr>{% endfor %}</table>{% endblock %}
