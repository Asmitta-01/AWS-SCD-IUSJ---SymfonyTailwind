{% extends 'base.html.twig' %}

{% block title %}Transactions - SalesBoard{% endblock %}

{% block body %}
    <h1>Transactions</h1>

    <table>
        <thead>
            <tr>
                <th>Reference</th>
                <th>Sale</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for transaction in transactions %}
                <tr>
                    <td>{{ transaction.reference }}</td>
                    <td>{{ transaction.sale.reference }}</td>
                    <td>{{ transaction.customer.fullName }}</td>
                    <td>{{ transaction.amount|number_format(2) }}</td>
                    <td>{{ transaction.paymentMethod.value }}</td>
                    <td>{{ transaction.status.value }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
