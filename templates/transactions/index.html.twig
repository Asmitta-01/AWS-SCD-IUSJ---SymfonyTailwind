{% extends 'base.html.twig' %}

{% block title %}Transactions - SalesBoard{% endblock %}
{% block page_heading %}Transactions{% endblock %}
{% block page_subtitle %}Review incoming and outgoing payments{% endblock %}

{% block body %}
    <div><h2 class="text-xl font-semibold tracking-tight">Payment activity</h2><p class="mt-1 text-sm text-muted-foreground">{{ transactions|length }} transactions across your sales</p></div>
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm"><div class="flex items-center gap-3 border-b border-border p-4"><label class="relative flex-1"><span class="sr-only">Search transactions</span>{% include 'components/_icon.html.twig' with {name: 'search', class: 'absolute left-3 top-2.5 size-4 text-muted-foreground'} %}<input type="search" placeholder="Search transactions..." class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm outline-none placeholder:text-muted-foreground focus:ring-2 focus:ring-ring"></label><select class="hidden h-9 rounded-md border border-input bg-background px-3 text-sm text-muted-foreground sm:block"><option>All statuses</option><option>Completed</option><option>Pending</option><option>Failed</option></select></div><div class="overflow-x-auto"><table class="w-full min-w-[800px] text-sm"><thead><tr class="border-b border-border bg-muted/40 text-left text-[10px] uppercase tracking-wider text-muted-foreground"><th class="px-5 py-3 font-medium">Reference</th><th class="px-3 py-3 font-medium">Sale</th><th class="px-3 py-3 font-medium">Customer</th><th class="px-3 py-3 text-right font-medium">Amount</th><th class="px-3 py-3 font-medium">Method</th><th class="px-5 py-3 text-right font-medium">Status</th></tr></thead><tbody class="divide-y divide-border">{% for transaction in transactions %}<tr class="transition-colors hover:bg-muted/60"><td class="px-5 py-3 font-mono text-xs font-medium">{{ transaction.reference }}</td><td class="px-3 py-3 font-mono text-xs text-muted-foreground">{{ transaction.sale.reference }}</td><td class="px-3 py-3 font-medium">{{ transaction.customer.fullName }}</td><td class="px-3 py-3 text-right font-mono tabular-nums">{{ transaction.amount|number_format(2) }}</td><td class="px-3 py-3 text-muted-foreground">{{ transaction.paymentMethod.value|replace({'_': ' '})|title }}</td><td class="px-5 py-3 text-right">{% include 'components/_badge.html.twig' with {label : transaction.status.value|capitalize, tone : transaction.status.value == 'completed' ? 'success' : transaction.status.value == 'pending' ? 'warning' : 'danger'} %}</td></tr>{% else %}<tr><td colspan="6" class="px-5 py-8 text-center text-sm text-muted-foreground">No transactions found.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
